# Copiar a .env (cp .env.example .env) y completar. El .env NO se sube a git.

# --- Dominio y front ---
DOMAIN=despescar.duckdns.org
# Sin barra final
FRONTEND_URL=https://tu-proyecto.vercel.app

# --- Base de datos (panel de Aiven -> Connection information) ---
DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL_MODE=REQUIRED
DB_POOL_SIZE=3

# --- Secretos (generar cada uno distinto: openssl rand -base64 48) ---
JWT_SECRET=
INVENTORY_SERVICE_TOKEN=
RESERVATION_SERVICE_SYNC_TOKEN=
PAYMENT_SERVICE_SYNC_TOKEN=

# --- Pagos ---
# mock = pago simulado desde el front (no cobra nada).
# mercadopago_orders = tarjeta en /pago/mercadopago (Checkout API): necesita ACCESS_TOKEN y PUBLIC_KEY, y el
# servicio NO arranca sin ellos. Con credenciales de PRUEBA no se mueve dinero (tarjetas de prueba).
# mercadopago = Checkout Pro (redirige a Mercado Pago): necesita ACCESS_TOKEN.
PAYMENT_PROVIDER=mock

# --- Servicios externos ---
GROQ_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Ingreso con Google (client id OAuth de tipo Web; es publico). Vacio = boton deshabilitado ---
# El origen del front (https://tu-proyecto.vercel.app) debe figurar en "Origenes de JavaScript autorizados".
GOOGLE_CLIENT_ID=

# --- Usuarios que crea el seed (database/seed/seed.py). Define contraseñas propias y fuertes ---
# ADMIN_EMAIL=admin@despescar.com
# ADMIN_PASSWORD=
# CLIENT_EMAIL=cliente@despescar.com
# CLIENT_PASSWORD=

# --- Memoria de cada servicio Java (opcional) ---
# JAVA_OPTS=-Xmx300m -XX:+UseSerialGC
